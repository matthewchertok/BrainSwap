# Public browser-safe Supabase project values (replace; examples are nonfunctional)
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
PUBLIC_APP_NAME=BrainSwap
PUBLIC_APP_TAGLINE=Hand off AI jobs when your model cannot finish them.
# Optional server-only metadata webhook. Never prefix this with PUBLIC_.
# NOTIFICATION_WEBHOOK_URL=https://hooks.example.invalid/replace-me
# Server-only access-request email delivery. All three are required to enable
# automatic requests. Never prefix these with PUBLIC_.
# RESEND_API_KEY=replace-with-a-restricted-send-only-key
# ACCESS_REQUEST_EMAIL_TO=operator@example.com
# ACCESS_REQUEST_EMAIL_FROM=onboarding@resend.dev
# Local Google OAuth is disabled by the checked-in Supabase config. If you deliberately
# enable [auth.external.google] for local testing, reference these only through env(...).
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=replace-me
