{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "brainswap",
  "compatibility_date": "2026-09-03",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "preview_urls": false,
  "observability": {
    "enabled": false
  },
  "main": ".svelte-kit/cloudflare/_worker.js",
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare"
  }
}
